# Copy to .env and fill in what you have. Leave a block empty to use the local stand-in.
# Never commit .env.

# Amplitude: audit trail events
AMPLITUDE_API_KEY=

# SingleStore: threats and actions store (HTTP Data API)
SINGLESTORE_HOST=
SINGLESTORE_USER=
SINGLESTORE_PASSWORD=
SINGLESTORE_DATABASE=

# Superlinked SIE: OpenAI-compatible chat endpoint
SIE_BASE_URL=
SIE_API_KEY=
SIE_MODEL=

# Statsig: client key for the report page (browser-safe); server secret for the agent's gates
STATSIG_CLIENT_KEY=
STATSIG_SERVER_SECRET=

# Persona Relay (sandbox key from the Persona form; used by the Node sidecar in persona/)
PERSONA_API_KEY=
# Shared between the web app and the Persona sidecar (any random string of 16+ characters)
GUARDIAN_SIDECAR_SECRET=
# Superlinked SIE for the model's second look: SIE_BASE_URL=https://api.superlinked.com/v1, SIE_MODEL=Qwen/Qwen3.5-4B
