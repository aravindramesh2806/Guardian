# Copy to .env and fill in what you have. Leave a block empty to use the local stand-in.
# Never commit .env.

# Amplitude: audit trail events
AMPLITUDE_API_KEY=

# SingleStore: threats and actions store (HTTP Data API)
SINGLESTORE_HOST=
SINGLESTORE_USER=
SINGLESTORE_PASSWORD=
SINGLESTORE_DATABASE=

# Superlinked SIE. URL + key turn on known-scam matching (embeddings, BAAI/bge-m3);
# SIE_MODEL also turns on chat for borderline labels and alert drafts.
SIE_BASE_URL=https://api.superlinked.com/v1
SIE_API_KEY=
SIE_MODEL=Qwen/Qwen3.5-4B
SIE_EMBED_MODEL=BAAI/bge-m3

# Statsig: client key for the report page (browser-safe); server secret for the agent's gates
STATSIG_CLIENT_KEY=
STATSIG_SERVER_SECRET=

# Persona Relay (sandbox key from the Persona form; used by the Node sidecar, not yet built)
PERSONA_API_KEY=
