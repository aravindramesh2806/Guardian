# Copy to .env and fill in what you have. Leave a block empty to use the local stand-in.
# Never commit .env.

# Amplitude: audit trail events
AMPLITUDE_API_KEY=

# SingleStore: threats and actions store (HTTP Data API)
SINGLESTORE_HOST=
SINGLESTORE_USER=
SINGLESTORE_PASSWORD=
SINGLESTORE_DATABASE=

# Superlinked SIE: OpenAI-compatible chat endpoint
SIE_BASE_URL=
SIE_API_KEY=
SIE_MODEL=

# Persona Relay (sandbox key from the Persona form; used by the Node sidecar, not yet built)
PERSONA_API_KEY=
