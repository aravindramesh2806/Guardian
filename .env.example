# Copy to .env and fill in what you have. Leave a block empty to use the local stand-in.
# Never commit .env.

# Amplitude: audit trail events
AMPLITUDE_API_KEY=

# SingleStore: threats and actions store (HTTP Data API)
SINGLESTORE_HOST=
SINGLESTORE_USER=
SINGLESTORE_PASSWORD=
SINGLESTORE_DATABASE=

# Superlinked SIE: OpenAI-compatible chat endpoint
SIE_BASE_URL=
SIE_API_KEY=
SIE_MODEL=

# Statsig: client key for the report page (browser-safe); server secret for the agent's gates
STATSIG_CLIENT_KEY=
STATSIG_SERVER_SECRET=

# Persona Relay (sandbox key from the Persona form; used by the Node sidecar in persona/)
PERSONA_API_KEY=
# Shared between the web app and the Persona sidecar (any random string of 16+ characters)
GUARDIAN_SIDECAR_SECRET=
# Superlinked SIE for the model's second look: SIE_BASE_URL=https://api.superlinked.com/v1, SIE_MODEL=Qwen/Qwen3.5-4B

# Web app: master key that seals each person's encryption key. Generate one with:
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it out of the users/ folder (in production, a secrets manager). Losing it makes stored mail unreadable.
GUARDIAN_MASTER_KEY=

# Gmail (read-only), from Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
# Redirect URI: http://localhost:8800/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-up codes by email (any SMTP provider). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, your address
# as SMTP_USER and an app password (Google Account > Security > 2-Step Verification > App passwords).
# Without these, codes are written to users/dev_mail.log on this machine (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# On a public address (tunnel or server)
GUARDIAN_ORIGIN=
GUARDIAN_RP_ID=
GUARDIAN_TRUST_PROXY=1
GUARDIAN_CONTACT=

# Demo sign-in for presentations: one ready-made account ("Rose") that signs in with a username and PIN.
# Off unless set to 1, and only works when the app runs on localhost. Real accounts always use passkeys.
GUARDIAN_DEMO_LOGIN=0
GUARDIAN_DEMO_USER=rose
GUARDIAN_DEMO_PIN=482913
